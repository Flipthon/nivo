# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://ksazlveybmumososvsyr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Aparecem na política de privacidade (exigida pela Play Store).
NEXT_PUBLIC_RESPONSAVEL=Seu nome completo
NEXT_PUBLIC_CONTACT_EMAIL=seu-email@exemplo.com

# Preencha só quando gerar o app Android (PWABuilder). Vários certificados: separe por vírgula.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

# Deixe false até configurar o login da Apple (exige Apple Developer Program).
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Anti-robô no login (Cloudflare Turnstile, gratuito). Deixe vazio para desligar.
# A chave secreta vai no Supabase (Authentication > Attack Protection), não aqui.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ID do cliente OAuth do Google (público). Usado pelo botão oficial do Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
